// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Users {
  id           String   @id @default(uuid()) @db.Uuid
  first_name   String
  last_name    String
  age          Int?
  role         Roles    @default(USER)
  email        String   @unique
  passwordHash String   @map("password_hash")
  avatar       String?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  workspaceMembers WorkspaceMembers[]
  boardMembers     BoardMembers[]
  assignedCards    Cards[]            @relation("assignedTo")
  comments         Comments[]

  @@map("users")
}

model WorkspaceMembers {
  id         String   @id @default(uuid()) @db.Uuid
  role       String   @default("MEMBER")
  created_at DateTime @default(now())

  userId String @map("user_id") @db.Uuid
  user   Users  @relation(fields: [userId], references: [id], onDelete: Cascade)

  workspaceId String     @map("workspace_id") @db.Uuid
  workspace   Workspaces @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@map("workspace_members")
}

model BoardMembers {
  id         String   @id @default(uuid()) @db.Uuid
  role       String   @default("MEMBER")
  created_at DateTime @default(now())

  userId String @map("user_id") @db.Uuid
  user   Users  @relation(fields: [userId], references: [id], onDelete: Cascade)

  boardId String @map("board_id") @db.Uuid
  board   Boards @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@unique([userId, boardId])
  @@map("board_members")
}

model Workspaces {
  id         String   @id @default(uuid()) @db.Uuid
  title      String
  image      String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  boards  Boards[]
  members WorkspaceMembers[]

  @@map("workspaces")
}

model Boards {
  id         String   @id @default(uuid()) @db.Uuid
  title      String
  image      String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  workspaceId String     @map("workspace_id") @db.Uuid
  workspace   Workspaces @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  columns Columns[]
  members BoardMembers[]
  labels  Labels[]

  @@map("boards")
}

model Columns {
  id         String   @id @default(uuid()) @db.Uuid
  title      String
  order      Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  boardId String @map("board_id") @db.Uuid
  board   Boards @relation(fields: [boardId], references: [id], onDelete: Cascade)

  cards Cards[]

  @@map("columns")
}

model Cards {
  id          String    @id @default(uuid()) @db.Uuid
  title       String
  description String?
  dueDate     DateTime? @map("due_date")
  order       Int       @default(0)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  columnId String  @map("column_id") @db.Uuid
  column   Columns @relation(fields: [columnId], references: [id], onDelete: Cascade)

  assignedToId String? @map("assigned_to_id") @db.Uuid
  assignedTo   Users?  @relation("assignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  comments Comments[]
  labels   CardLabels[]

  @@map("cards")
}

model Comments {
  id         String   @id @default(uuid()) @db.Uuid
  text       String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  userId String @map("user_id") @db.Uuid
  user   Users  @relation(fields: [userId], references: [id], onDelete: Cascade)

  cardId String @map("card_id") @db.Uuid
  card   Cards  @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@map("comments")
}

model Labels {
  id      String @id @default(uuid()) @db.Uuid
  title   String
  color   String
  boardId String @map("board_id") @db.Uuid
  board   Boards @relation(fields: [boardId], references: [id], onDelete: Cascade)

  cards CardLabels[]

  @@map("labels")
}

model CardLabels {
  cardId  String @map("card_id") @db.Uuid
  card    Cards  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  labelId String @map("label_id") @db.Uuid
  label   Labels @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([cardId, labelId])
  @@map("card_labels")
}

enum Roles {
  USER
  ADMIN
}
